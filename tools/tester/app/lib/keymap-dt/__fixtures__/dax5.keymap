#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define MAC_GESTURE 7

&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <200>;

    g_back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LEFT_BRACKET)>;
    };

    g_fwd {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RIGHT_BRACKET)>;
    };

    g_top {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(UP_ARROW)>;
    };

    g_bottom {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(DOWN_ARROW)>;
    };
};

/ {
    zip_mouse_gesture_mac: zip_mouse_gesture_mac {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <300>;
        enable-eager-mode;
        always-active;
        idle-timeout-ms = <150>;
        gesture-cooldown-ms = <200>;

        mg_desktop {
            pattern = <GESTURE_UP>;
            bindings = <&kp F11>;
        };

        mg_mission_control {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp RC(UP_ARROW)>;
        };

        mg_app_expose {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp RC(DOWN)>;
        };

        mg_spotlight {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(SPACE)>;
        };
    };
};

&mt {
    quick-tap-ms = <0>;
    tapping-term-ms = <160>;
    flavor = "balanced";
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <160>;
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        to_bluetooth {
            bindings = <&mo 6>;
            key-positions = <0 29>;
            layers = <0>;
        };

        kl_scroll {
            bindings = <&mo 5>;
            key-positions = <20 21>;
            layers = <0>;
        };
    };

    macros {
        esc_lang2: esc_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESCAPE &kp LANG2>;
        };

    };

    behaviors {
        esc_lang2_with_layer: esc_lang2_with_layer {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&esc_lang2>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
        };

        enc_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // All 8 layers cover the dax5 44-key matrix (rows 13/12/13/6).
        // The default_layer bindings are placeholder identifiers so serialize
        // tests can assert per-column content; real keymaps live in
        // `config/dax5.keymap`.

        default_layer {
            bindings = <
&kp A   &kp Q   &kp W   &kp E   &kp R   &kp T                   &kp Y   &kp U   &kp I       &kp O     &kp P         &kp A
&kp A   &kp A   &kp S   &kp D   &kp F   &kp G                   &kp H   &kp J   &kp K       &kp L     &kp SEMI      &kp A
&kp A   &kp Z   &kp X   &kp C   &kp V   &kp B   &kp A   &kp A   &kp N   &kp M   &kp COMMA   &kp DOT   &kp SLASH     &kp A
                        &kp A   &kp A   &kp A   &kp A   &kp A   &kp A
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN   &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        Symbol {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&enc_scroll SCRL_RIGHT SCRL_LEFT>,
                <&enc_scroll SCRL_RIGHT SCRL_LEFT>;
        };

        Num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };

        Function {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        Device {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        MacGesture {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

    };
};
