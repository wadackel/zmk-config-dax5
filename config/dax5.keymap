#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define MAC_GESTURE 7

&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <200>;

    g_back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LEFT_BRACKET)>;
    };

    g_fwd {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RIGHT_BRACKET)>;
    };

    g_top {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(UP_ARROW)>;
    };

    g_bottom {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(DOWN_ARROW)>;
    };
};

/ {
    zip_mouse_gesture_mac: zip_mouse_gesture_mac {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <300>;
        enable-eager-mode;
        always-active;
        idle-timeout-ms = <150>;
        gesture-cooldown-ms = <200>;

        mg_desktop {
            pattern = <GESTURE_UP>;
            bindings = <&kp F11>;
        };

        mg_mission_control {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp RC(UP_ARROW)>;
        };

        mg_app_expose {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp RC(DOWN)>;
        };

        mg_spotlight {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(SPACE)>;
        };
    };
};

&mt {
    quick-tap-ms = <0>;
    tapping-term-ms = <160>;
    flavor = "balanced";
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <160>;
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        to_device {
            bindings = <&mo 6>;
            key-positions = <0 29>;
            layers = <0>;
        };

        kl_scroll {
            bindings = <&mo 5>;
            key-positions = <20 21>;
            layers = <0>;
        };
    };

    macros {
        esc_lang2: esc_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESCAPE &kp LANG2>;
        };
    };

    behaviors {
        esc_lang2_with_layer: esc_lang2_with_layer {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&esc_lang2>;
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
        };

        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            bindings = <&msc>, <&msc>;
            #sensor-binding-cells = <2>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB      &kp Q   &kp W   &kp E      &kp R            &kp T                                                                            &kp Y         &kp U   &kp I       &kp O     &kp P             &kp MINUS
&kp LCTRL    &kp A   &kp S   &kp D      &kp F            &kp G                                                                            &kp H         &kp J   &kp K       &kp L     &lt 4 SEMICOLON   &lt 5 SQT
&kp LSHIFT   &kp Z   &kp X   &kp C      &kp V            &kp B              &kp DELETE                                    &kp BACKSPACE   &kp N         &kp M   &kp COMMA   &kp DOT   &kp SLASH         &mkp MB1
                             &kp LALT   &mt LGUI LANG2   &mt LSHIFT SPACE   &esc_lang2_with_layer 3 ESC                   &lt 2 ENTER     &lt 1 LANG1
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        Symbol {
            bindings = <
&trans   &kp TILDE   &kp GRAVE   &kp DLLR   &kp PRCNT   &kp CARET                                          &trans     &kp AMPS    &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &trans      &trans
&trans   &kp EXCL    &kp AT      &kp HASH   &kp EQUAL   &kp PLUS                                           &kp STAR   &kp UNDER   &kp LEFT_BRACKET       &kp RIGHT_BRACKET       &kp COLON   &kp DQT
&trans   &kp QMARK   &kp LT      &kp GT     &kp PIPE    &kp BACKSLASH   &trans                    &trans   &trans     &trans      &kp LEFT_BRACE         &kp RIGHT_BRACE         &trans      &trans
                                 &trans     &trans      &trans          &kp DOT                   &trans   &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_RIGHT SCRL_LEFT>, <&enc_scroll SCRL_RIGHT SCRL_LEFT>;
        };

        Num {
            bindings = <
&trans   &kp SLASH   &kp N7   &kp N8   &kp N9   &kp MINUS                                     &trans          &trans   &trans   &trans   &trans      &trans
&trans   &kp STAR    &kp N4   &kp N5   &kp N6   &kp PLUS                                      &kp BACKSPACE   &trans   &trans   &trans   &kp COLON   &trans
&trans   &kp N0      &kp N1   &kp N2   &kp N3   &kp PRCNT   &trans                   &trans   &trans          &trans   &trans   &trans   &trans      &trans
                              &trans   &trans   &trans      &trans                   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };

        Function {
            bindings = <
&kp LG(LS(N7))   &kp LG(LS(N4))       &kp F7   &kp F8   &kp F9   &kp LG(SPACE)                                         &kp C_MUTE   &kp C_PP   &kp C_VOL_DN   &kp C_VOL_UP   &trans   &trans
&trans           &kp LG(LS(LC(N4)))   &kp F4   &kp F5   &kp F6   &kp LG(LC(SPACE))                                     &kp LEFT     &kp DOWN   &kp UP         &kp RIGHT      &trans   &trans
&trans           &kp F10              &kp F1   &kp F2   &kp F3   &mo 6               &trans                   &trans   &trans       &trans     &trans         &trans         &trans   &trans
                                               &trans   &trans   &trans              &trans                   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };

        Mouse {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                                                       &kp F11                     &kp LG(R)   &mo 7      &mouse_gesture   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                                                       &kp LC(UP)                  &mkp MB1    &mkp MB3   &mkp MB2         &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans                   &trans                     &kp LC(DOWN)                &mkp MB4    &mkp MB5   &kp LG(W)        &trans   &trans
                           &trans   &trans   &trans   &trans                   &kp LG(LS(LEFT_BRACKET))   &kp LG(LS(RIGHT_BRACKET))
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        Scroll {
            bindings = <
&trans   &trans   &trans                 &kp LG(LA(LC(K)))    &kp LG(LA(LC(M)))      &kp LG(LA(LC(C)))                                         &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &kp LG(LA(LC(LEFT)))   &kp LG(LA(LC(UP)))   &kp LG(LA(LC(DOWN)))   &kp LG(LA(LC(RIGHT)))                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &kp LG(LA(LC(N1)))     &kp LG(LA(LC(N2)))   &kp LG(LA(LC(N3)))     &kp LG(LA(LC(N4)))      &trans                   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                                         &trans               &trans                 &trans                  &trans                   &trans   &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        Device {
            bindings = <
&bootloader   &trans   &trans   &trans   &trans   &to 0                                      &to 0          &trans         &trans         &trans         &trans         &bootloader
&trans        &trans   &trans   &trans   &trans   &trans                                     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans
&trans        &trans   &trans   &trans   &trans   &trans   &trans                   &trans   &trans         &trans         &trans         &trans         &trans         &trans
                                &trans   &trans   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&enc_scroll SCRL_DOWN SCRL_UP>;
        };

        MacGesture {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans                   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                           &trans   &trans   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&enc_scroll SCRL_DOWN SCRL_UP>;
        };
    };
};
