#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define MAC_GESTURE 7
#define GESTURE 8

#include "gestures.dtsi"

&mt {
    quick-tap-ms = <0>;
    tapping-term-ms = <160>;
    flavor = "balanced";
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <160>;
    quick-tap-ms = <0>;
};

/ {
    // Compile-time defaults for the runtime combos (`cormoran__runtime_combo`). A
    // slot edited or deleted from a settings app keeps that stored value.
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        mo_device {
            slot = <0>;
            bindings = <&mo 6>;
            key-positions = <0 29>;
            layers = <0>;
        };

        kl_scroll {
            slot = <1>;
            bindings = <&mo 5>;
            key-positions = <20 21>;
            layers = <0>;
        };

        to_device_l {
            slot = <2>;
            bindings = <&to 6>;
            key-positions = <0 12 24>;
            layers = <0>;
        };

        to_device_r {
            slot = <3>;
            bindings = <&to 6>;
            key-positions = <11 23 37>;
            layers = <0>;
        };
    };

    // Compile-time default for runtime macro slot 0 (`cormoran__runtime_macro`), so a
    // settings app can edit it. A default takes the first free slot when it is first
    // created; with this as the only default that is slot 0 after a settings reset.
    // `esc_lang2_with_layer` passes that slot number as its tap parameter.
    esc_lang2 {
        compatible = "cormoran,runtime-macro-default";
        bindings = <&macro_tap>, <&kp ESCAPE &kp LANG2>;
        wait-ms = <15>;
    };

    // The rsr_* behaviors are compile-time defaults for the encoders. A settings
    // app overrides them per sensor and layer at runtime, and a layer only becomes
    // editable there when its sensor-bindings resolve to one of them. Every variant
    // sets tap-ms to 20, including the &kp ones: &msc ticks every 16 ms, and a
    // rebind reuses the layer's current tap-ms, so the binding default of 5 would
    // leave a later &msc silent.
    behaviors {
        esc_lang2_with_layer: esc_lang2_with_layer {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer-Macro";
            bindings = <&mo>, <&rmacro>;
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
        };

        rsr_scroll: rsr_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };

        rsr_scroll_rev: rsr_scroll_rev {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        rsr_hscroll: rsr_hscroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_RIGHT>;
            ccw-binding = <&msc SCRL_LEFT>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };

        rsr_bri: rsr_bri {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&kp C_BRI_INC>;
            ccw-binding = <&kp C_BRI_DEC>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB      &kp Q   &kp W   &kp E      &kp R            &kp T                                                                            &kp Y         &kp U   &kp I       &kp O     &kp P             &kp MINUS
&kp LCTRL    &kp A   &kp S   &kp D      &kp F            &kp G                                                                            &kp H         &kp J   &kp K       &kp L     &lt 4 SEMICOLON   &lt 5 SQT
&kp LSHIFT   &kp Z   &kp X   &kp C      &kp V            &kp B              &kp DELETE                                    &kp BACKSPACE   &kp N         &kp M   &kp COMMA   &kp DOT   &kp SLASH         &mkp MB1
                             &kp LALT   &mt LGUI LANG2   &mt LSHIFT SPACE   &esc_lang2_with_layer 3 0                     &lt 2 ENTER     &lt 1 LANG1
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        Symbol {
            bindings = <
&trans   &kp TILDE   &kp GRAVE   &kp DLLR   &kp PRCNT   &kp CARET                                          &trans     &kp AMPS    &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &trans      &trans
&trans   &kp EXCL    &kp AT      &kp HASH   &kp EQUAL   &kp PLUS                                           &kp STAR   &kp UNDER   &kp LEFT_BRACKET       &kp RIGHT_BRACKET       &kp COLON   &kp DQT
&trans   &kp QMARK   &kp LT      &kp GT     &kp PIPE    &kp BACKSLASH   &trans                    &trans   &trans     &trans      &kp LEFT_BRACE         &kp RIGHT_BRACE         &trans      &trans
                                 &trans     &trans      &trans          &kp DOT                   &trans   &trans
            >;

            sensor-bindings = <&rsr_hscroll>, <&rsr_hscroll>;
        };

        Num {
            bindings = <
&trans   &kp SLASH   &kp N7   &kp N8   &kp N9   &kp MINUS                                      &trans          &trans   &trans   &trans   &trans      &trans
&trans   &kp STAR    &kp N4   &kp N5   &kp N6   &kp PLUS                                       &kp BACKSPACE   &trans   &trans   &trans   &kp COLON   &trans
&trans   &kp N0      &kp N1   &kp N2   &kp N3   &kp PRCNT   &trans                    &trans   &trans          &trans   &trans   &trans   &trans      &trans
                              &trans   &trans   &trans      &kp DOT                   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_bri>;
        };

        Function {
            bindings = <
&kp LG(LS(N7))   &kp LG(LS(N4))       &kp F7   &kp F8   &kp F9   &kp LG(SPACE)                                         &kp C_MUTE   &kp C_PP   &kp C_VOL_DN   &kp C_VOL_UP   &trans   &trans
&trans           &kp LG(LS(LC(N4)))   &kp F4   &kp F5   &kp F6   &kp LG(LC(SPACE))                                     &kp LEFT     &kp DOWN   &kp UP         &kp RIGHT      &trans   &trans
&trans           &kp F10              &kp F1   &kp F2   &kp F3   &mo 6               &trans                   &trans   &trans       &trans     &trans         &trans         &trans   &trans
                                               &trans   &trans   &trans              &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_bri>;
        };

        Mouse {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                                                       &kp F11                     &kp LG(R)   &mo 7      &mo 8             &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                                                       &kp LC(UP)                  &mkp MB1    &mkp MB3   &mkp MB2         &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans                   &trans                     &kp LC(DOWN)                &mkp MB4    &mkp MB5   &kp LG(W)        &trans   &trans
                           &trans   &trans   &trans   &trans                   &kp LG(LS(LEFT_BRACKET))   &kp LG(LS(RIGHT_BRACKET))
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        Scroll {
            bindings = <
&trans   &trans   &trans                 &kp LG(LA(LC(K)))    &kp LG(LA(LC(M)))      &kp LG(LA(LC(C)))                                         &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &kp LG(LA(LC(LEFT)))   &kp LG(LA(LC(UP)))   &kp LG(LA(LC(DOWN)))   &kp LG(LA(LC(RIGHT)))                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &kp LG(LA(LC(N1)))     &kp LG(LA(LC(N2)))   &kp LG(LA(LC(N3)))     &kp LG(LA(LC(N4)))      &trans                   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                                         &trans               &trans                 &trans                  &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        Device {
            bindings = <
&bootloader   &trans   &trans   &trans   &trans   &to 0                                      &to 0          &trans         &trans         &trans         &trans         &bootloader
&trans        &trans   &trans   &trans   &trans   &trans                                     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans
&trans        &trans   &trans   &trans   &trans   &trans   &trans                   &trans   &trans         &trans         &trans         &trans         &trans         &trans
                                &trans   &trans   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        MacGesture {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans                   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                           &trans   &trans   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        // Held from the Mouse layer, like MacGesture. Neither changes a key: they exist so that
        // the gesture processor has a layer to tell "gestures on" by (config/gestures.dtsi).
        Gesture {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans                   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                           &trans   &trans   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };
    };
};
