#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
      zmk,physical-layout = &dax5_physical_layout;
    };

    dax5_physical_layout: dax5_physical_layout {
      compatible = "zmk,physical-layout";
      display-name = "Default";
      transform = <&default_transform>;
      kscan = <&kscan0>;

      // Ortholinear visualization layout (not PCB-true).
      // Each transform col maps to a unique 100u-wide column:
      //   col 0..6 → x = col * 100         (left side: 0..600)
      //   col 7..13 → x = (col - 7) * 100 + 900   (right side: 900..1500)
      // Row index → y = row * 100.
      // Only R2 populates both outer columns c6 (L) and c7 (R). R3 uses L c3..c6 + R c7..c8.
      keys //                       w   h    x    y  rot rx ry
        // Row 0 (matrix R0): L cols 0-5, R cols 8-13
        = <&key_physical_attrs 100 100    0    0   0  0  0>  //  0: R0C0
        , <&key_physical_attrs 100 100  100    0   0  0  0>  //  1: R0C1
        , <&key_physical_attrs 100 100  200    0   0  0  0>  //  2: R0C2
        , <&key_physical_attrs 100 100  300    0   0  0  0>  //  3: R0C3
        , <&key_physical_attrs 100 100  400    0   0  0  0>  //  4: R0C4
        , <&key_physical_attrs 100 100  500    0   0  0  0>  //  5: R0C5
        , <&key_physical_attrs 100 100 1000    0   0  0  0>  //  6: R0C8
        , <&key_physical_attrs 100 100 1100    0   0  0  0>  //  7: R0C9
        , <&key_physical_attrs 100 100 1200    0   0  0  0>  //  8: R0C10
        , <&key_physical_attrs 100 100 1300    0   0  0  0>  //  9: R0C11
        , <&key_physical_attrs 100 100 1400    0   0  0  0>  // 10: R0C12
        , <&key_physical_attrs 100 100 1500    0   0  0  0>  // 11: R0C13
        // Row 1 (matrix R1): L cols 0-5, R cols 8-13
        , <&key_physical_attrs 100 100    0  100   0  0  0>  // 12: R1C0
        , <&key_physical_attrs 100 100  100  100   0  0  0>  // 13: R1C1
        , <&key_physical_attrs 100 100  200  100   0  0  0>  // 14: R1C2
        , <&key_physical_attrs 100 100  300  100   0  0  0>  // 15: R1C3
        , <&key_physical_attrs 100 100  400  100   0  0  0>  // 16: R1C4
        , <&key_physical_attrs 100 100  500  100   0  0  0>  // 17: R1C5
        , <&key_physical_attrs 100 100 1000  100   0  0  0>  // 18: R1C8
        , <&key_physical_attrs 100 100 1100  100   0  0  0>  // 19: R1C9
        , <&key_physical_attrs 100 100 1200  100   0  0  0>  // 20: R1C10
        , <&key_physical_attrs 100 100 1300  100   0  0  0>  // 21: R1C11
        , <&key_physical_attrs 100 100 1400  100   0  0  0>  // 22: R1C12
        , <&key_physical_attrs 100 100 1500  100   0  0  0>  // 23: R1C13
        // Row 2 (matrix R2): L cols 0-6, R cols 7-13
        , <&key_physical_attrs 100 100    0  200   0  0  0>  // 24: R2C0
        , <&key_physical_attrs 100 100  100  200   0  0  0>  // 25: R2C1
        , <&key_physical_attrs 100 100  200  200   0  0  0>  // 26: R2C2
        , <&key_physical_attrs 100 100  300  200   0  0  0>  // 27: R2C3
        , <&key_physical_attrs 100 100  400  200   0  0  0>  // 28: R2C4
        , <&key_physical_attrs 100 100  500  200   0  0  0>  // 29: R2C5
        , <&key_physical_attrs 100 100  600  200   0  0  0>  // 30: R2C6
        , <&key_physical_attrs 100 100  900  200   0  0  0>  // 31: R2C7
        , <&key_physical_attrs 100 100 1000  200   0  0  0>  // 32: R2C8
        , <&key_physical_attrs 100 100 1100  200   0  0  0>  // 33: R2C9
        , <&key_physical_attrs 100 100 1200  200   0  0  0>  // 34: R2C10
        , <&key_physical_attrs 100 100 1300  200   0  0  0>  // 35: R2C11
        , <&key_physical_attrs 100 100 1400  200   0  0  0>  // 36: R2C12
        , <&key_physical_attrs 100 100 1500  200   0  0  0>  // 37: R2C13
        // Row 3 (matrix R3): L cols 3-6, R cols 7-8
        , <&key_physical_attrs 100 100  300  300   0  0  0>  // 38: R3C3
        , <&key_physical_attrs 100 100  400  300   0  0  0>  // 39: R3C4
        , <&key_physical_attrs 100 100  500  300   0  0  0>  // 40: R3C5
        , <&key_physical_attrs 100 100  600  300   0  0  0>  // 41: R3C6
        , <&key_physical_attrs 100 100  900  300   0  0  0>  // 42: R3C7
        , <&key_physical_attrs 100 100 1000  300   0  0  0>  // 43: R3C8
        ;
    };

    default_transform: keymap_transform_0 {
      compatible = "zmk,matrix-transform";
      columns = <14>;
      rows = <4>;
      map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                    RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                    RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)    RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                                RC(3,3) RC(3,4) RC(3,5) RC(3,6)    RC(3,7) RC(3,8)
      >;
    };

    kscan0: kscan {
      compatible = "zmk,kscan-gpio-matrix";
      wakeup-source;
      diode-direction = "col2row";
      row-gpios
        = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D0/P0.02 -> Row0
        , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D1/P0.03 -> Row1
        , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D2/P0.28 -> Row2
        , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D3/P0.29 -> Row3
        ;
    };

    left_encoder: encoder_left {
      compatible = "alps,ec11";
      steps = <80>;
      status = "disabled";
    };

    right_encoder: encoder_right {
      compatible = "alps,ec11";
      steps = <80>;
      status = "disabled";
    };

    sensors: sensors {
      compatible = "zmk,keymap-sensors";
      sensors = <&left_encoder &right_encoder>;
      triggers-per-rotation = <40>;
    };
};

&uicr {
  nfct-pins-as-gpios;
};
